+                    }
+                }
+
+                bearer = mme_bearer_next(bearer);
+            }
+
+            /* Mark PDN deletion flag */
+            if (pdn_mismatch) {
+                sess->ue_pdn_status_mismatch = true;
+            }
+        }
+    }
+
     return OGS_OK;
 }
 
