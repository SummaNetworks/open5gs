+static bool mme_imsi_in_range(const char *imsi, 
+                              const char *start_imsi, 
+                              const char *end_imsi, 
+                              bool is_single)
+{
+    if (is_single) {
+        return strcmp(imsi, start_imsi) == 0;
+    } else {
+        return (strcmp(imsi, start_imsi) >= 0 && 
+                strcmp(imsi, end_imsi) <= 0);
+    }
+}
