Co-Authored-By: Claude <noreply@anthropic.com>
---
 src/mme/mme-s11-handler.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/mme/mme-s11-handler.c b/src/mme/mme-s11-handler.c
index cb1cf7d62..93f567070 100644
--- a/src/mme/mme-s11-handler.c
+++ b/src/mme/mme-s11-handler.c
@@ -1903,7 +1903,12 @@ void mme_s11_handle_create_indirect_data_forwarding_tunnel_response(
     }

     source_ue = enb_ue_find_by_id(mme_ue->enb_ue_id);
-    ogs_assert(source_ue);
+    if (!source_ue) {
+        ogs_error("[%s] Source ENB-S1 context has already been removed",
+                mme_ue->imsi_bcd);
+        mme_ue_clear_indirect_tunnel(mme_ue);
+        return;
+    }

     r = s1ap_send_handover_command(source_ue);
     ogs_expect(r == OGS_OK);
